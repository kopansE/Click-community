# ============================================
# Click App — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
# ============================================

# ── Supabase ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Supabase Auth (Phone/OTP via Twilio) ─────
# Configure in Supabase Dashboard > Auth > Phone Provider
# These are set in the Supabase dashboard, not here.
# But if using custom Twilio setup:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stream Chat (GetStream.io) ───────────────
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# ── PayPal ───────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Set to "sandbox" for dev, "live" for production
PAYPAL_ENVIRONMENT=sandbox

# ── App Config ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Click

# ── Push Notifications (future) ──────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# FCM_SERVER_KEY=
